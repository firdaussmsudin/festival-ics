{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Film Festival Dataset",
  "type": "object",
  "required": ["festivals"],
  "properties": {
    "festivals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uid",
          "name",
          "country",
          "startDate",
          "endDate",
          "category",
          "status",
          "sourceUrl"
        ],
        "properties": {
          "uid": {
            "type": "string",
            "description": "Stable per-edition identifier, e.g. cannes-2026@festival-ics.example. Used as the ICS UID.",
            "pattern": "^[a-z0-9-]+@[a-z0-9.-]+$"
          },
          "name": { "type": "string", "minLength": 1 },
          "country": { "type": "string", "minLength": 1 },
          "city": { "type": "string" },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone, e.g. Europe/Paris. Defaults to UTC if omitted."
          },
          "category": {
            "type": "string",
            "enum": [
              "festival",
              "market",
              "festival-and-market",
              "awards-ceremony"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["confirmed", "tentative", "cancelled", "rescheduled"]
          },
          "website": { "type": "string", "format": "uri" },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "description": "Where this entry was sourced/verified. Required so PRs are reviewable."
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
